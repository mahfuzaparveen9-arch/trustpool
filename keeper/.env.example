# TrustPool Keeper Configuration
# Copy this to .env and fill in your values

# RPC URL (Anvil local or Base Sepolia)
RPC_URL=http://127.0.0.1:8545

# Private key for the keeper wallet (will receive liquidation bounties)
# NEVER commit your real private key!
# For Anvil, use one of the default accounts:
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed contract addresses (from deployments.json)
LENDING_POOL_ADDRESS=
MUSDC_ADDRESS=
MWETH_ADDRESS=

# Check interval in milliseconds (default: check every 2 seconds)
CHECK_INTERVAL_MS=2000

# Chain ID (31337 for Anvil, 84532 for Base Sepolia)
CHAIN_ID=31337
